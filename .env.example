# Copy this file to .env and fill in your values.
# See SETUP-GOOGLE-SHEET.md for how to get the URL.

# Google Apps Script Web App URL that appends registrations to your sheet.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Optional shared secret. If set, it must match the SECRET in your Apps Script.
# SHEETS_WEBHOOK_TOKEN=

# Secret used to sign session cookies for Sign in / Sign up. REQUIRED in prod.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-64-char-random-hex-string

# --- Email verification (6-digit signup code) ---
# With NO provider set, codes are printed to the server console (dev mode).
# For real emails, create a free key at https://resend.com and set:
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=SkyHunter <you@example.com>

# --- Social login (Google / LinkedIn) ---
# Buttons show on /signin and /signup regardless; they only work once keys are
# set. Register this redirect URI with each provider:
#   http://localhost:3000/api/auth/oauth/google/callback     (dev)
#   http://localhost:3000/api/auth/oauth/linkedin/callback   (dev)
# Google:   https://console.cloud.google.com  (OAuth client, type "Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn: https://www.linkedin.com/developers  ("Sign In with LinkedIn using OpenID Connect")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Supabase (database) ---
# From Supabase dashboard → Project Settings → API.
# Run supabase/schema.sql once in the SQL editor first.
# If these are blank, the app uses the local .data/ file store (dev).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key

# --- IP intelligence (signup location + VPN/VPS detection) ---
# Defaults to ip-api.com's free endpoint (returns proxy + hosting flags).
# ip-api's free tier is HTTP-only and non-commercial — for production, point
# this at a paid/keyed endpoint, e.g. https://pro.ip-api.com/json (add ?key=…).
# IP_LOOKUP_BASE=http://ip-api.com

# --- Admin ---
# Comma-separated emails that are always admins (in addition to the DB is_admin
# flag). Sign up with one of these to reach /admin.
ADMIN_EMAILS=you@example.com

# Do NOT set NODE_ENV here — it's managed by the platform (next dev = development,
# next build/start and Vercel = production). Setting it manually can break builds.
